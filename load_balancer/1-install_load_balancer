#!/usr/bin/env bash
# Installs and configures HAProxy (roundrobin) for web-01 and web-02
sudo apt-get update -y
sudo apt-get install -y haproxy

if ! grep -q "http_back" /etc/haproxy/haproxy.cfg; then
sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null <<'EOF'

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7253-web-01 3.10.169.232:80 check
    server 7253-web-02 3.8.49.140:80 check
EOF
fi

sudo systemctl enable haproxy
sudo service haproxy restart
